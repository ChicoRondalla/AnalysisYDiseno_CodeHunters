<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="640.0" prefWidth="850.0" style="-fx-background-color: #0a0a0c;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uam.ayd.proyecto.presentacion.registrarMesa.ControlMesa">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="50.0" layoutY="30.0" prefHeight="580.0" prefWidth="750.0" spacing="20.0">
         <children>
            <!-- Header -->
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="PLANO DE SALA" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label text="Seleccione la mesa a ocupar para registrar pedido" textFill="#9ca3af">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>

            <!-- Grid de Mesas (Fila 1: Mesas 1, 2, 3) -->
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="btnMesa1" mnemonicParsing="false" onAction="#handleSeleccionarMesa1" prefHeight="110.0" prefWidth="210.0" style="-fx-background-color: #212126; -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 12;" text="MESA 1&#10;Capacidad: 4 pers.&#10;LIBRE" textFill="WHITE" />
                  <Button fx:id="btnMesa2" mnemonicParsing="false" onAction="#handleSeleccionarMesa2" prefHeight="110.0" prefWidth="210.0" style="-fx-background-color: #212126; -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 12;" text="MESA 2&#10;Capacidad: 2 pers.&#10;OCUPADA" textFill="WHITE" />
                  <Button fx:id="btnMesa3" mnemonicParsing="false" onAction="#handleSeleccionarMesa3" prefHeight="110.0" prefWidth="210.0" style="-fx-background-color: #212126; -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 12;" text="MESA 3&#10;Capacidad: 6 pers.&#10;LIBRE" textFill="WHITE" />
               </children>
            </HBox>

            <!-- Grid de Mesas (Fila 2: Mesas 4, 5) -->
            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <Button fx:id="btnMesa4" mnemonicParsing="false" onAction="#handleSeleccionarMesa4" prefHeight="110.0" prefWidth="210.0" style="-fx-background-color: #212126; -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 12;" text="MESA 4&#10;Capacidad: 4 pers.&#10;LIBRE" textFill="WHITE" />
                  <Button fx:id="btnMesa5" mnemonicParsing="false" onAction="#handleSeleccionarMesa5" prefHeight="110.0" prefWidth="210.0" style="-fx-background-color: #212126; -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 12;" text="MESA 5&#10;Capacidad: 4 pers.&#10;LIBRE" textFill="WHITE" />
               </children>
            </HBox>

            <!-- Panel de Acciones Inferior -->
            <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="750.0" spacing="20.0" style="-fx-background-color: #1d1d22; -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 10;">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label fx:id="lblEstadoSeleccion" text="Mesa no seleccionada" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <Label text="Haga clic en una mesa para gestionarla" textFill="#9ca3af" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" spacing="10.0">
                     <children>
                        <Button fx:id="btnRegistrarPedido" mnemonicParsing="false" onAction="#handleRegistrarPedido" style="-fx-background-color: #e11d48; -fx-text-fill: white; -fx-background-radius: 6;" text="Registrar Pedido" />
                        <Button fx:id="btnCambiarEstado" mnemonicParsing="false" onAction="#handleCambiarEstado" style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: #d1d5db; -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 6;" text="Cambiar Estado" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- Botón Regresar -->
            <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#handleRegresar" style="-fx-background-color: transparent; -fx-text-fill: #d1d5db; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 6; -fx-padding: 8 30;" text="Regresar" />
         </children>
      </VBox>
   </children>
</AnchorPane>