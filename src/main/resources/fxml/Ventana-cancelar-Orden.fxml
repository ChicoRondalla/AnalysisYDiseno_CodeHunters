<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="450.0" spacing="0.0" 
      style="-fx-background-color: #1a1012; -fx-background-radius: 10; -fx-border-color: #382427; -fx-border-radius: 10; -fx-border-width: 1;" 
      xmlns="http://javafx.com/javafx/26" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="mx.uam.ayd.proyecto.presentacion.cancelarOrden.VistaCancelarOrden">  
   <children>
      <!-- Header Bar en Negro Mate elegante -->
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #120b0c; -fx-background-radius: 10 10 0 0; -fx-border-color: #2e1e20; -fx-border-width: 0 0 1 0;">
         <children>
            <Label text="⚠ " textFill="#e53e3e">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label text="Anular Orden" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets left="15.0" right="15.0" />
         </padding>
      </HBox>

      <VBox spacing="15.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <!-- Cuadro de Alerta -->
            <VBox spacing="5.0" style="-fx-background-color: #26181a; -fx-border-color: #5d1e23; -fx-border-radius: 5; -fx-background-radius: 5;">
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
               <children>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="ℹ" textFill="#e8b4b8">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <VBox>
                           <children>
                              <Label fx:id="mensajeOrdenLabel" text="Estás a punto de cancelar la orden " textFill="WHITE" wrapText="true" />
                              <Label text="Esta acción no se puede deshacer." textFill="#e8b4b8">
                                 <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Campo de Texto (Motivo) -->
            <VBox spacing="8.0">
               <children>
                  <Label text="Motivo de cancelación *" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label text="Es obligatorio ingresar el motivo de la cancelación." textFill="#e8b4b8">
                     <font>
                        <Font size="11.0" />
                     </font>
                  </Label>
                  <TextArea fx:id="motivoArea" prefHeight="100.0" promptText="Ej. Cliente no quiso esperar, Falta de pago, Error de captura, etc." style="-fx-control-inner-background: #26181a; -fx-text-fill: white; -fx-prompt-text-fill: #888888; -fx-border-color: #382427; -fx-border-radius: 5; -fx-background-radius: 5;" wrapText="true" />
                  <HBox alignment="TOP_RIGHT">
                     <children>
                        <Label fx:id="charCountLabel" text="0 / 200" textFill="#aaaaaa" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Cuadro de Información -->
            <HBox spacing="10.0" style="-fx-background-color: #26181a; -fx-border-color: #382427; -fx-border-radius: 5; -fx-background-radius: 5;">
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
               <children>
                  <Label text="ⓘ" textFill="#cccccc" />
                  <Label text="Al confirmar, la orden será marcada como &quot;Cancelada&quot; y se notificará inmediatamente a cocina para detener la preparación." textFill="#cccccc" wrapText="true">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <!-- Botones de Acción Estáticos (Estructura idéntica al FXML original) -->
            <HBox spacing="15.0">
               <children>
                  <Button fx:id="volverBtn" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: #277a44; -fx-text-fill: white; -fx-background-radius: 5;" text="Volver" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="confirmarBtn" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: #c53030; -fx-text-fill: white; -fx-background-radius: 5;" text="🗑  Confirmar Cancelación" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>