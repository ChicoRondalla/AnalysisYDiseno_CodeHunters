<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1180.0" styleClass="root-dark" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uam.ayd.proyecto.presentacion.tablaEmpleados.ControlTablaEmpleados">
   <stylesheets>
      <URL value="@../styles/estilos-tabla.css" />
   </stylesheets>
   
   <!-- BARRA LATERAL IZQUIERDA (SIDEBAR) -->
   <left>
      <VBox prefWidth="240.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="20.0" />
         </padding>
         <children>
            <!-- Logo y Marca -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="⚔" textFill="#ef4444">
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
                  <VBox spacing="1.0">
                     <children>
                        <Label text="Ryuho Sushi" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Label text="Administración Omakase" textFill="#6b7280">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets bottom="24.0" />
               </VBox.margin>
            </HBox>

            <!-- Menú de Navegación -->
            <VBox spacing="6.0">
               <children>
                  <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-btn" text="⚔  Menú" />
                  <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-btn, sidebar-btn-active" text="🪪  Personal" />
                  <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-btn" text="⚙  Configuración" />
               </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Tarjeta de Perfil de Usuario Inferior -->
            <VBox spacing="10.0" styleClass="profile-card">
               <padding>
                  <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label alignment="CENTER" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #2b2e38; -fx-background-radius: 50%;" text="👨‍🍳" />
                        <VBox spacing="2.0">
                           <children>
                              <Label text="Kenji Sato" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <Label text="• EN LÍNEA" textFill="#22c55e">
                                 <font>
                                    <Font name="System Bold" size="10.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#actionCerrarSesion" style="-fx-background-color: transparent; -fx-cursor: hand;" text="🚪" textFill="#9ca3af" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Pie de Sidebar -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
               <children>
                  <Label text="Terminal POS #04" textFill="#6b7280">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="v2.4.1" textFill="#6b7280">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </VBox>
   </left>

   <!-- PANEL CENTRAL DE LA TABLA -->
   <center>
      <StackPane alignment="TOP_CENTER" BorderPane.alignment="CENTER">
      <VBox maxWidth="1200.0" spacing="20.0" StackPane.alignment="TOP_CENTER">
         <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
         </padding>
         <children>
            <!-- Cabecera Principal -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label text="Personal" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="24.0" />
                                 </font>
                              </Label>
                              <HBox alignment="CENTER" spacing="4.0" styleClass="badge-turno">
                                 <children>
                                    <Label text="•" textFill="#ef4444">
                                       <font>
                                          <Font name="System Bold" size="14.0" />
                                       </font>
                                    </Label>
                                    <Label text="12 Activos en Turno" textFill="#e5e7eb">
                                       <font>
                                          <Font size="11.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        <Label text="Directorio de colaboradores, asignación de roles y accesos al sistema" textFill="#9ca3af" wrapText="true">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <HBox alignment="CENTER" minWidth="-Infinity" spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" styleClass="btn-icon" text="↻" />
                        <Button mnemonicParsing="false" styleClass="btn-icon" text="🔔" />
                        <Button fx:id="btnRegistrarEmpleado" mnemonicParsing="false" styleClass="btn-primary-red" text="+ Registrar Empleado" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- Tarjeta Contenedora de Búsqueda y Tabla -->
            <VBox spacing="15.0" styleClass="card-container" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>
               <children>
                  <!-- Barra de Búsqueda y Filtros -->
                  <FlowPane alignment="CENTER_LEFT" hgap="10.0" vgap="8.0">
                     <children>
                        <TextField fx:id="txtBuscar" prefWidth="280.0" promptText="🔍 Buscar por nombre, usuario o rol..." styleClass="search-field" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                           <children>
                              <Button text="Todos">
                                 <styleClass>
                                    <String fx:value="filter-chip" />
                                    <String fx:value="filter-chip-active" />
                                 </styleClass>
                              </Button>
                              <Button styleClass="filter-chip" text="Administrador" />
                              <Button styleClass="filter-chip" text="Recepcionista" />
                              <Button styleClass="filter-chip" text="Cocinero" />
                              <Button styleClass="filter-chip" text="Repartidor" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="4.0" styleClass="toggle-container">
                           <children>
                              <Button text="Activos">
                                 <styleClass>
                                    <String fx:value="filter-chip" />
                                    <String fx:value="toggle-chip-active" />
                                 </styleClass>
                              </Button>
                              <Button styleClass="filter-chip" text="Inactivos" />
                           </children>
                        </HBox>
                     </children>
                  </FlowPane>

                  <!-- Tabla de Empleados -->
                  <TableView fx:id="tablaEmpleados" prefHeight="380.0" prefWidth="850.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="columnaNombre" prefWidth="300.0" text="NOMBRE COMPLETO" />
                      <TableColumn fx:id="columnaUsuario" prefWidth="200.0" text="NOMBRE DE USUARIO" />
                      <TableColumn fx:id="columnaRol" prefWidth="180.0" text="ROL" />
                      <TableColumn fx:id="columnaAcciones" prefWidth="120.0" style="-fx-alignment: CENTER;" text="ACCIONES" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

                  <!-- Pie de Tabla y Paginación -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label fx:id="lblConteoEmpleados" text="Mostrando 4 de 12 empleados" textFill="#9ca3af">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="6.0">
                           <children>
                              <Button styleClass="btn-page" text="&lt; Anterior" />
                              <Button text="1">
                                 <styleClass>
                                    <String fx:value="btn-page" />
                                    <String fx:value="btn-page-active" />
                                 </styleClass>
                              </Button>
                              <Button styleClass="btn-page" text="2" />
                              <Button styleClass="btn-page" text="3" />
                              <Button styleClass="btn-page" text="Siguiente &gt;" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
      </StackPane>
   </center>
</BorderPane>